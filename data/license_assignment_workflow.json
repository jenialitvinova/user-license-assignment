      "name": "Get Available Licenses"
    },
    {
      "parameters": {
        "jsCode": "const pendingUsers = $input.all();\n\nconst apiUsers = $('Get API Users').first().json.value;\nconst licenses = $('Get Available Licenses').first().json.value;\n\n// Ищем лицензию M365_E3\nconst license = licenses.find(\n    l => l.skuPartNumber === 'M365_E3'\n);\n\nif (!license) {\n    throw new Error('License M365_E3 not found');\n}\n\nreturn pendingUsers.map(item => {\n    const dbUser = item.json;\n\n    const apiUser = apiUsers.find(\n        u => u.userPrincipalName === dbUser.user_principal_name\n    );\n\n    return {\n        json: {\n            userId: dbUser.id,\n            apiUserId: apiUser?.id,\n            licenseId: license.id,\n            userPrincipalName: dbUser.user_principal_name\n        }\n    };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
