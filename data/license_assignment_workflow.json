    {
      "parameters": {
        "jsCode": "const pendingUsers = $input.all();\n\nconst apiUsers = $('GET Users').first().json.value;\nconst licenses = $('GET Licenses').first().json.value;\n\n// Ищем лицензию M365_E3\nconst license = licenses.find(\n    l => l.skuPartNumber === 'M365_E3'\n);\n\nif (!license) {\n    throw new Error('License M365_E3 not found');\n}\n\nreturn pendingUsers.map(item => ({\n    json: {\n        dbUser: item.json,\n        apiUsers,\n        license\n    }\n}));"
